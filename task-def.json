{
    "family": "default-moneybay-backend",
    "containerDefinitions": [
        {
            "name": "Main",
            "image": "172575865299.dkr.ecr.us-east-2.amazonaws.com/moneybay-usa:latest",
            "cpu": 256,
            "memory": 512,
            "memoryReservation": 512,
            "portMappings": [
                {
                    "containerPort": 8080,
                    "hostPort": 8080,
                    "protocol": "tcp",
                    "name": "main-8080-tcp"
                }
            ],
            "essential": true,
            "command": [],
            "environment": [
                {
                    "name": "DATABASE_URL",
                    "value": "jdbc:postgresql://db-moneybay-usa.c18o4s6gatg6.us-east-2.rds.amazonaws.com:5432/moneybay"
                },
                {
                    "name": "DB_USERNAME",
                    "value": "moneybayusa"
                },
                {
                    "name": "SPRING_PROFILES_ACTIVE",
                    "value": "production"
                },
                {
                    "name": "R2_PUBLIC_URL",
                    "value": "https://photos.moneybay.us"
                },
                {
                    "name": "GOOGLE_CLIENT_ID",
                    "value": "755478741339-adaamehn3di26aj2jgth4odpuh7dcqmq.apps.googleusercontent.com"
                },
                {
                    "name": "FACEBOOK_APP_ID",
                    "value": "2651880961948531"
                },
                {
                    "name": "STRIPE_SECRET_KEY",
                    "value": "sk_test_dummy"
                },
                {
                    "name": "STRIPE_WEBHOOK_SECRET",
                    "value": "whsec_dummy"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "secrets": [
                {
                    "name": "DB_PASSWORD",
                    "valueFrom": "arn:aws:secretsmanager:us-east-2:172575865299:secret:moneybay/db-password-OGoHjR"
                },
                {
                    "name": "JWT_SECRET",
                    "valueFrom": "arn:aws:secretsmanager:us-east-2:172575865299:secret:moneybay/jwt-secret-0gwTY8"
                },
                {
                    "name": "GOOGLE_CLIENT_SECRET",
                    "valueFrom": "arn:aws:secretsmanager:us-east-2:172575865299:secret:moneybay/oauth-PgrAzv:GOOGLE_CLIENT_SECRET::"
                },
                {
                    "name": "FACEBOOK_APP_SECRET",
                    "valueFrom": "arn:aws:secretsmanager:us-east-2:172575865299:secret:moneybay/oauth-PgrAzv:FACEBOOK_APP_SECRET::"
                },
                {
                    "name": "R2_ACCESS_KEY_ID",
                    "valueFrom": "arn:aws:secretsmanager:us-east-2:172575865299:secret:moneybay/oauth-PgrAzv:R2_ACCESS_KEY_ID::"
                },
                {
                    "name": "R2_SECRET_ACCESS_KEY",
                    "valueFrom": "arn:aws:secretsmanager:us-east-2:172575865299:secret:moneybay/oauth-PgrAzv:R2_SECRET_ACCESS_KEY::"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "moneybay-backend",
                    "awslogs-region": "us-east-2",
                    "awslogs-stream-prefix": "moneybay"
                }
            },
            "healthCheck": {
                "command": ["CMD-SHELL", "exit 0"],
                "interval": 30,
                "timeout": 5,
                "retries": 3,
                "startPeriod": 180
            }
        }
    ],
    "taskRoleArn": "arn:aws:iam::172575865299:role/ecsTaskExecutionRole",
    "executionRoleArn": "arn:aws:iam::172575865299:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "volumes": [],
    "requiresCompatibilities": ["FARGATE"],
    "runtimePlatform": {
        "cpuArchitecture": "ARM64",
        "operatingSystemFamily": "LINUX"
    },
    "cpu": "256",
    "memory": "512"
}
