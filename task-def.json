            "portMappings": [
                {
                    "containerPort": 8080,
                    "hostPort": 8080,
                    "protocol": "tcp",
                    "name": "main-8080-tcp"
                }
            ],
            "essential": true,
            "command": [],
            "environment": [
                {
                    "name": "DATABASE_URL",
                    "value": "jdbc:postgresql://db-moneybay-usa.c5qkmgi6m2e9.eu-north-1.rds.amazonaws.com:5432/moneybay"
                },
                {
                    "name": "DB_USERNAME",
                    "value": "moneybayusa"
                },
                {
                    "name": "JWT_SECRET",
                    "value": "Jv6s9CLn1FmwMtYhqHiPUdcIQbSrao7p"
                },
                {
                    "name": "DB_PASSWORD",
                    "value": "!CA1987j7!CA1987j7"
                },
                {
                    "name": "SPRING_PROFILES_ACTIVE",
                    "value": "production"
                },
                {
                    "name": "STRIPE_SECRET_KEY",
                    "value": "sk_test_dummy"
                },
                {
                    "name": "STRIPE_WEBHOOK_SECRET",
                    "value": "whsec_dummy"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "secrets": [],
            "logConfiguration": {
