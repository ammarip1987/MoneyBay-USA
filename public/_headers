# Файлы Angular несут отпечаток в имени: при изменении меняется имя, значит
# кэшировать их можно надолго. Прежде Cloudflare отдавал их с max-age=0 и
# must-revalidate — браузер спрашивал сервер о свежести при каждом открытии, и
# при запуске, пока сеть поднимается, страница успевала отрисоваться без стилей.
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=31536000, immutable

# Разметку у себя Cloudflare держит минуту, браузеру же кэш запрещён: в ней
# имена файлов сборки, и старая копия в браузере указывала бы на исчезнувшие.
#
# Без этого из 112 тысяч суточных обращений в кэш попадало 539 — всё остальное
# уходило в отрисовку.
/
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=60, stale-while-revalidate=600

/index.html
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=60, stale-while-revalidate=600
