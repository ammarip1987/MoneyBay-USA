{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/assets/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-categories",
      "urls": [
        "/api/categories",
        "/api/categories/**",
        "/api/subcategories/**",
        "/api/cities",
        "/api/cities/**"
      ],
      "cacheConfig": {
        "maxSize": 100,
        "maxAge": "1d",
        "timeout": "10s",
        "strategy": "freshness"
      }
    },
    {
      "name": "api-listings-read",
      "urls": [
        "/api/listings",
        "/api/listings/*",
        "/api/listings/*/similar",
        "/api/listings/suggest"
      ],
      "cacheConfig": {
        "maxSize": 200,
        "maxAge": "5m",
        "timeout": "5s",
        "strategy": "freshness"
      }
    },
    {
      "name": "uploads",
      "urls": [
        "/api/uploads/**"
      ],
      "cacheConfig": {
        "maxSize": 500,
        "maxAge": "7d",
        "timeout": "5s",
        "strategy": "performance"
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/api/**",
    "!/ws/**",
    "!/actuator/**"
  ]
}
