{
  "name": "moneybay-usa",
  "compatibility_date": "2026-08-03",
  "main": "./dist/moneybay-angular/server/server.mjs",
  "assets": {
    // Файл ищется первым; до серверной отрисовки доходят только адреса,
    // для которых статики нет
    "directory": "./dist/moneybay-angular/browser",
    "binding": "ASSETS",
    // Обращения к API минуют поиск файла и идут прямо в код: иначе на них
    // отдавалась страница «не найдено», ведь такого файла нет
    "run_worker_first": ["/api/*"]
  }
}
