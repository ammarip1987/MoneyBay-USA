{
  "name": "moneybay-usa",
  "compatibility_date": "2026-08-03",
  // Точка входа — обёртка вокруг обработчика Angular. Кэш в ней написан, но
  // не срабатывает: до кода дело не доходит, Cloudflare отвечает из assets.
  // К этому вернуться при переезде на новый домен
  "main": "./worker/index.mjs",
  "assets": {
    // Файл ищется первым; до серверной отрисовки доходят только адреса,
    // для которых статики нет
    "directory": "./dist/moneybay-angular/browser",
    "binding": "ASSETS"
  }
}
