# Neon PostgreSQL (https://neon.tech -> your project -> Connect)
# Copy the connection string and convert it to JDBC form (add jdbc: and params):
DATABASE_URL=jdbc:postgresql://<host>-pooler.<region>.aws.neon.tech/moneybay?sslmode=require&channel_binding=require
DB_USERNAME=your_neon_user
DB_PASSWORD=your_neon_password

# Cloudflare R2 Configuration
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=moneybayts-photos
R2_REGION=auto
