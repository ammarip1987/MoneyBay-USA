{
  "name": "moneybay-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:worker": "esbuild worker/worker.ts --bundle --format=esm --platform=neutral --external:xhr2 --external:sockjs-client --external:node:* --external:../dist/moneybay-angular/server/server.mjs --outfile=worker/index.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-server": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/service-worker": "^22.2.2",
    "@angular/ssr": "^22.2.2",
    "@stomp/stompjs": "^7.3.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "sockjs-client": "^1.6.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/express": "^5.0.1",
    "@types/node": "^25.8.0",
    "@types/sockjs-client": "^1.5.4",
    "autoprefixer": "^10.5.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.1",
    "sass": "^1.99.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
